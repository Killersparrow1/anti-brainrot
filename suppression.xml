<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-check.1.3.xsd">
  <!-- Suppress known false positives for Android/Gradle dependencies -->
  
  <!-- AndroidX Test - false positive for test-only dependencies -->
  <suppress>
    <notes>AndroidX test dependencies are test-only, not bundled in release APK</notes>
    <gav regex="true">androidx\.test:.*</gav>
    <cpe>cpe:2.3:a:google:android:*:*:*:*:*:*:*:*</cpe>
  </suppress>

  <!-- Espresso - test only -->
  <suppress>
    <notes>Espresso is test-only dependency</notes>
    <gav regex="true">androidx\.test\.espresso:.*</gav>
  </suppress>

  <!-- Kotlin stdlib - false positives for core library -->
  <suppress>
    <notes>Kotlin standard library false positives</notes>
    <gav regex="true">org\.jetbrains\.kotlin:kotlin-stdlib.*</gav>
  </suppress>

  <!-- Coroutines - false positives -->
  <suppress>
    <notes>Kotlinx coroutines false positives</notes>
    <gav regex="true">org\.jetbrains\.kotlinx:kotlinx-coroutines.*</gav>
  </suppress>

  <!-- OkHttp - false positives for transitive deps -->
  <suppress>
    <notes>OkHttp transitive dependencies</notes>
    <gav regex="true">com\.squareup\.okhttp3:okhttp.*</gav>
  </suppress>

  <!-- Moshi - false positives -->
  <suppress>
    <notes>Moshi JSON library</notes>
    <gav regex="true">com\.squareup\.moshi:moshi.*</gav>
  </suppress>

  <!-- Retrofit - false positives -->
  <suppress>
    <notes>Retrofit networking library</notes>
    <gav regex="true">com\.squareup\.retrofit2:retrofit.*</gav>
  </suppress>

  <!-- Room - false positives -->
  <suppress>
    <notes>Room database library</notes>
    <gav regex="true">androidx\.room:room.*</gav>
  </suppress>

  <!-- Hilt/Dagger - false positives -->
  <suppress>
    <notes>Hilt/Dagger DI framework</notes>
    <gav regex="true">com\.google\.dagger:.*</gav>
    <gav regex="true">androidx\.hilt:.*</gav>
  </suppress>

  <!-- Compose - false positives -->
  <suppress>
    <notes>Jetpack Compose UI toolkit</notes>
    <gav regex="true">androidx\.compose:.*</gav>
    <gav regex="true">androidx\.compose\.ui:.*</gav>
    <gav regex="true">androidx\.compose\.material3:.*</gav>
    <gav regex="true">androidx\.compose\.runtime:.*</gav>
    <gav regex="true">androidx\.compose\.animation:.*</gav>
    <gav regex="true">androidx\.compose\.foundation:.*</gav>
    <gav regex="true">androidx\.constraintlayout:constraintlayout-compose.*</gav>
  </suppress>

  <!-- Glance widgets - false positives -->
  <suppress>
    <notes>Glance app widget library</notes>
    <gav regex="true">androidx\.glance:.*</gav>
  </suppress>

  <!-- Firebase - false positives for BOM -->
  <suppress>
    <notes>Firebase Bill of Materials</notes>
    <gav regex="true">com\.google\.firebase:firebase-bom.*</gav>
  </suppress>

  <!-- Play Services - false positives -->
  <suppress>
    <notes>Google Play Services</notes>
    <gav regex="true">com\.google\.android\.gms:.*</gav>
  </suppress>

  <!-- Facebook SDK - false positives -->
  <suppress>
    <notes>Facebook Android SDK</notes>
    <gav regex="true">com\.facebook\.android:facebook-android-sdk.*</gav>
  </suppress>

  <!-- RevenueCat - false positives -->
  <suppress>
    <notes>RevenueCat purchases SDK</notes>
    <gav regex="true">com\.revenuecat\.purchases:.*</gav>
  </suppress>

  <!-- Razorpay - false positives -->
  <suppress>
    <notes>Razorpay checkout SDK</notes>
    <gav regex="true">com\.razorpay:checkout.*</gav>
  </suppress>

  <!-- Coil - false positives -->
  <suppress>
    <notes>Coil image loading library</notes>
    <gav regex="true">io\.coil-kt:coil.*</gav>
  </suppress>

  <!-- WorkManager - false positives -->
  <suppress>
    <notes>WorkManager background processing</notes>
    <gav regex="true">androidx\.work:work.*</gav>
  </suppress>

  <!-- DataStore - false positives -->
  <suppress>
    <notes>DataStore preferences</notes>
    <gav regex="true">androidx\.datastore:datastore.*</gav>
  </suppress>

  <!-- Biometric - false positives -->
  <suppress>
    <notes>Biometric authentication</notes>
    <gav regex="true">androidx\.biometric:biometric.*</gav>
  </suppress>

  <!-- Navigation - false positives -->
  <suppress>
    <notes>Navigation component</notes>
    <gav regex="true">androidx\.navigation:.*</gav>
  </suppress>

  <!-- Lifecycle - false positives -->
  <suppress>
    <notes>Lifecycle components</notes>
    <gav regex="true">androidx\.lifecycle:.*</gav>
  </suppress>

  <!-- Serialization - false positives -->
  <suppress>
    <notes>Kotlinx serialization</notes>
    <gav regex="true">org\.jetbrains\.kotlinx:kotlinx-serialization.*</gav>
  </suppress>

  <!-- MockK - test only -->
  <suppress>
    <notes>MockK testing library</notes>
    <gav regex="true">org\.mockk:mockk.*</gav>
  </suppress>

  <!-- Mockito - test only -->
  <suppress>
    <notes>Mockito testing library</notes>
    <gav regex="true">org\.mockito:.*</gav>
  </suppress>

  <!-- JUnit - test only -->
  <suppress>
    <notes>JUnit testing framework</notes>
    <gav regex="true">junit:junit.*</gav>
    <gav regex="true">org\.junit:.*</gav>
  </suppress>

  <!-- Truth - test only -->
  <suppress>
    <notes>Google Truth testing library</notes>
    <gav regex="true">com\.google\.truth:truth.*</gav>
  </suppress>

  <!-- Robolectric - test only -->
  <suppress>
    <notes>Robolectric test framework</notes>
    <gav regex="true">org\.robolectric:robolectric.*</gav>
  </suppress>
</suppressions>